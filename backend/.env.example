# Copy this file to .env and fill in real values. Never commit .env itself
# (already excluded in .gitignore).

# Groq - primary Tier-2 LLM classifier (free tier). Get a key at console.groq.com
GROQ_API_KEY=

# Gemini - Tier-2 fallback if Groq is rate-limited. Get a key at aistudio.google.com
GEMINI_API_KEY=

# Langfuse - LLM observability (traces, human-review scoring). Free cloud
# account at cloud.langfuse.com, or self-host; see their docs for LANGFUSE_BASE_URL
# if self-hosting instead of the default cloud endpoint.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
